# AyurMind Backend Environment Configuration
# Based on Classical Ayurvedic Texts: Charaka Samhita, Sushruta Samhita, Ashtanga Hridayam

# Server Configuration
# Use PORT=5002 to match Vite proxy (vite.config.ts)
PORT=5002
NODE_ENV=development

# Database Configuration
# Local: mongodb://localhost:27017/ayurmind
# Atlas: mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/<DBNAME> (never commit real URI)
MONGODB_URI=mongodb://localhost:27017/ayurmind

# Frontend URL(s) for CORS — comma-separated for multiple
FRONTEND_URL=http://localhost:8080

# Security Configuration
# JWT_SECRET will be generated for you by `npm run setup:secrets`
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Health-check endpoint protection (only enforced when NODE_ENV=production)
HEALTH_CHECK_SECRET=

# Rate Limiting (global API limiter — auth + contact have stricter local limits)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Classical Knowledge Base Configuration
ENABLE_CLASSICAL_REFERENCES=true
ENABLE_SANSKRIT_VERSES=true
ENABLE_IAST_TRANSLITERATION=true

# Assessment Configuration
ASSESSMENT_VERSION=1.0.0
CONFIDENCE_THRESHOLD=70
MIN_QUESTIONS_REQUIRED=20

# Logging Configuration
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true

# API Documentation
ENABLE_SWAGGER=true
API_DOCS_PATH=/api-docs 